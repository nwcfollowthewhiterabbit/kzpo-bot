ENIQ_TOKEN=put_token_here
ENIQ_BASE_URL=https://new-api.aicallsupervisor.io/api/v1
ENIQ_PROJECT_ID=209
ENIQ_STATUS=completed
ENIQ_START_DATE=
ENIQ_END_DATE=
ENIQ_PAGE_SIZE=100
ENIQ_WITH_TRANSCRIPTION=1
DATABASE_URL=postgresql+psycopg2://eniq:eniq@localhost:5435/eniq

# Optional for future Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Timezone for reporting (e.g., Europe/Kyiv)
REPORT_TZ=Europe/Kyiv
WEEKLY_REPORT_CHAT_ID=

# For docker-compose networking
# DATABASE_URL=postgresql+psycopg2://eniq:eniq@db:5432/eniq

# OpenAI (для диалоговых ответов)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_SHEETS_SYNC_ENABLED=0
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Разом
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=.secrets/google_service_account.json
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SYNC_INTERVAL_SEC=300

# Ringostat API (optional)
RINGOSTAT_TOKEN=
RINGOSTAT_PROJECT_ID=

# Ringostat webhook (HTTP callback)
RINGOSTAT_WEBHOOK_ENABLED=1
RINGOSTAT_WEBHOOK_USER=
RINGOSTAT_WEBHOOK_PASSWORD=
RINGOSTAT_WEBHOOK_PORT=8080
