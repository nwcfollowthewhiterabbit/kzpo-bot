# Docker Compose settings
COMPOSE_PROJECT_NAME=kzpo-report-bot

# Public domain for Ringostat webhooks
PUBLIC_DOMAIN=example.com

# Traefik integration
TRAEFIK_ENABLE=true
TRAEFIK_PUBLIC_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_RESOLVER=main-resolver

# Optional host port overrides
APP_PORT=8080
DB_PORT=5435
